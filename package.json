{
  "name": "cocoapdf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CocoaPDF — a lightweight PDF viewer and editor in the CocoaSuite family",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "node e2e/acceptance.mjs"
  },
  "dependencies": {
    "@embedpdf/engines": "^2.15.1",
    "@embedpdf/models": "^2.15.1",
    "@embedpdf/pdfium": "^2.15.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.7",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
